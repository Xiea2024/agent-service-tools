# API keys for different providers
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false

#Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# Amazon Bedrock Knowledge Base ID
AWS_KB_ID="<knowledge-base-id>"

# Use a fake model for testing
USE_FAKE_MODEL=false

# Set a default model
DEFAULT_MODEL=

# If DEFAULT_MODEL is set to "openai-compatible", set the following
# This is just a flexible solution. If you need multiple model options, you still need to add it to models.py
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Web server configuration
HOST=127.0.0.1
PORT=8080

# Authentication secret, HTTP bearer token header is required if set.
# WARNING: If unset, all API endpoints are unauthenticated. Always set this in production.
AUTH_SECRET=

# Langsmith configuration
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Application mode. If the value is "dev", it will enable uvicorn reload
MODE=

# Database type.
# If the value is "postgres", then it will require Postgresql related environment variables.
# If the value is "sqlite", then you can configure optional file path via SQLITE_DB_PATH
DATABASE_TYPE=sqlite
# Opt-in team workspace. Requires DATABASE_TYPE=postgres; legacy Feishu/sample APIs
# are intentionally unavailable in this mode. See docs/multi-tenancy.md.
TENANT_MODE=false
# Keep true behind HTTPS. Local HTTP demo only: set false.
TENANT_COOKIE_SECURE=true
TENANT_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# If DATABASE_TYPE=sqlite (Optional)
SQLITE_DB_PATH=checkpoints.db

# If DATABASE_TYPE=postgres
# Docker Compose default values (will work with docker-compose setup)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# you will be able to identify AST connections in Postgres Connection Manager under this Application Name
# POSTGRES_APPLICATION_NAME = "agent-service-tools"
# set these values to customize the number of connections in the pool. Saver and store have independent connection pools
# POSTGRES_MIN_CONNECTIONS_PER_POOL=1
# POSTGRES_MAX_CONNECTIONS_PER_POOL= 3

# If DATABASE_TYPE=mongo
# See docker/compose.mongo.yaml for a local Mongo container to test against
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=
# MONGO_TLS=false

# OpenWeatherMap API key
OPENWEATHERMAP_API_KEY=

# Add for running ollama
# OLLAMA_MODEL=llama3.2
# Note: set OLLAMA_BASE_URL if running service in docker and ollama on bare metal
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Add for running Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_DEPLOYMENT_MAP={"gpt-5": "gpt-5-deployment", "gpt-5-mini": "gpt-5-mini-deployment"}

# Agent URL: used in Streamlit app - if not set, defaults to http://{HOST}:{PORT}
AGENT_URL=http://localhost:8080

# Prometheus metrics (optional; enable after configuring monitoring)
# Prometheus + Grafana: monitoring/README.md; restart both Python processes after enabling.
METRICS_ENABLED=false
# Docker Desktop scrapes via host.docker.internal. Bind 0.0.0.0 only if loopback is unreachable.
FEISHU_METRICS_HOST=127.0.0.1
FEISHU_METRICS_PORT=9101

# Langfuse tracing (optional; fill in project credentials before enabling)
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Use the endpoint of your Cloud project region.
# Legacy alias: configure LANGFUSE_HOST only when LANGFUSE_BASE_URL is absent.
# LANGFUSE_HOST=https://cloud.langfuse.com
# Default false: send structure/timing/usage and IDs, omit message and retrieval content.
LANGFUSE_CAPTURE_CONTENT=false
# Background telemetry export timeout, in seconds; no per-request auth check or flush.
LANGFUSE_TIMEOUT=3

# GitHub MCP Agent Configuration
# GitHub Personal Access Token (required for GitHub MCP server)
# If not set, the GitHub MCP agent will have no tools
GITHUB_PAT=

# Voice Features (Optional)
# NOTE: Voice features are configured on the client (Streamlit app) side, not the server (API).
# Requires OPENAI_API_KEY to be set (see above).
# Set provider name to enable voice input/output. Leave empty to disable.
VOICE_STT_PROVIDER=        # Speech-to-text provider (only 'openai' supported currently)
VOICE_TTS_PROVIDER=        # Text-to-speech provider (only 'openai' supported currently)

# 飞书自建应用：用于 src/run_feishu.py 的长连接单聊文本收发联调。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional: bypass proxies only for open.feishu.cn when the proxy breaks TLS.
FEISHU_BYPASS_PROXY=false
# Default true: TLS 1.2 compatibility for Feishu HTTPS and WebSocket, with verification.
FEISHU_FORCE_TLS12=true
# 飞书回复模式：agent 调用研发问题处理 Agent；echo 仅验证固定文本收发。
FEISHU_REPLY_MODE=agent
# FastAPI 后端地址；后端模型由现有 DEFAULT_MODEL 配置选择。
FEISHU_AGENT_URL=http://127.0.0.1:8080
# 请求超时（秒），默认大于研发问题处理 Agent 单轮 60 秒的模型超时。
FEISHU_AGENT_TIMEOUT=75
# redis 使用 Streams + SQLite 任务台账，需先启动 Redis；memory 为可选内存队列。
FEISHU_QUEUE_BACKEND=redis
FEISHU_REDIS_URL=redis://127.0.0.1:6379/0
# Redis 去重索引的 TTL；SQLite 任务记录仍用于长期幂等检查。
FEISHU_REDIS_DEDUP_TTL=86400
# FEISHU_TASK_DB_PATH=.local/feishu-tasks.sqlite3
# 会话列表与当前选择；模型消息仍保存在后端 checkpoint 数据库中。
# 默认是项目根目录下的 .local/feishu-sessions.sqlite3，无需额外填写。
# FEISHU_SESSION_DB_PATH=.local/feishu-sessions.sqlite3
# 回答快照与用户评价；agent 模式默认使用带反馈表单的回答卡片。
# FEISHU_FEEDBACK_DB_PATH=.local/feishu-feedback.sqlite3
# 飞书菜单 eval_start / eval_status；回归复用 CLI 评测器，后台同时只执行一个任务。
FEISHU_EVAL_ENABLED=true
# FEISHU_EVAL_DB_PATH=.local/evaluation-jobs.sqlite3
FEISHU_EVAL_CASES_PATH=evals/supportpilot/cases.json
# FEISHU_EVAL_OUTPUT_ROOT=evals/supportpilot/runs
# FEISHU_EVAL_TIMEOUT=90
# FEISHU_EVAL_MODEL=openai-compatible
# 选填：限制可操作评测的 open_id，逗号分隔；空值允许机器人可交互用户操作自己的任务。
# FEISHU_EVAL_ALLOWED_OPEN_IDS=ou_xxx
# 选填：报告存放文件夹 token；留空则在应用云空间创建，并仅向发起人授予直接阅读权限。
# FEISHU_REPORT_FOLDER_TOKEN=
# 后端开启认证时，复用上方已有 AUTH_SECRET；不要重复定义。

# 独立向量模型：硅基流动 BAAI/bge-m3；与聊天模型的 COMPATIBLE_* 配置分开。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=30
# SDK 最多重试次数；1 表示首次失败后最多再尝试一次。
EMBEDDING_MAX_RETRIES=1
# 遇到 SSLV3_ALERT_BAD_RECORD_MAC 可启用 TLS 1.2 兼容；仍校验证书。
EMBEDDING_FORCE_TLS12=false

# 文档向量存储；本机 Docker 演示仅绑定 127.0.0.1 的 REST 端口。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=dev_issue_documents_bge_m3_v1
QDRANT_API_KEY=
QDRANT_TIMEOUT=15

# 检索返回条数、Cosine 分数下限和每段正文上限；阈值需通过后续评测校准。
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.45
RAG_MAX_CHARS=1200
