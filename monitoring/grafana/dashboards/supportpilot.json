{
  "uid": "supportpilot-overview",
  "title": "SupportPilot · 运行监控",
  "tags": [
    "supportpilot"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "采集目标在线状态",
      "type": "stat",
      "description": "1=指标端点可达；不等于飞书长连接或所有外部依赖正常。",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"supportpilot-.*\"}",
          "legendFormat": "{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "问答交付成功率 · 最近一小时",
      "type": "stat",
      "description": "按任务最后更新时间统计当前结果；包含 failed、needs_review；无完成任务时无数据。不是答案正确率。",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(supportpilot_tasks_last_hour{state=\"succeeded\"}) / sum(supportpilot_tasks_last_hour)",
          "legendFormat": "{{state}}{{operation}}{{outcome}}{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "当前排队 / 执行 / 待发卡任务",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supportpilot_tasks{state=~\"queued|invoking|ready\"}",
          "legendFormat": "{{state}}{{operation}}{{outcome}}{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "需要人工处理",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supportpilot_tasks{state=~\"needs_review|blocked\"}",
          "legendFormat": "{{state}}{{operation}}{{outcome}}{{job}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "title": "最长活动任务年龄",
      "type": "timeseries",
      "description": "从入队计时，包括执行和发卡。",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supportpilot_oldest_active_task_age_seconds",
          "legendFormat": "{{state}}{{operation}}{{outcome}}{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "成功问答平均端到端耗时 · 最近一小时",
      "type": "timeseries",
      "description": "创建到最终状态更新时间，含排队、重启与发送等待；不是纯模型耗时。",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supportpilot_task_average_duration_last_hour_seconds",
          "legendFormat": "{{state}}{{operation}}{{outcome}}{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "最近一小时任务结果",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supportpilot_tasks_last_hour",
          "legendFormat": "{{state}}{{operation}}{{outcome}}{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "模型 / 检索结果速率",
      "type": "timeseries",
      "description": "按操作计数，含 SDK 内部重试的总调用。检索 no_results 单列，错误不当作成功。",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation,outcome) (rate(supportpilot_operations_total[5m]))",
          "legendFormat": "{{operation}} {{outcome}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "模型 / 检索 P95",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,operation) (rate(supportpilot_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} {{outcome}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "HTTP 响应速率",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(supportpilot_http_requests_total[5m]))",
          "legendFormat": "{{status}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Worker 与任务数据库",
      "type": "stat",
      "description": "端点在线但 Worker 退出/数据库不可读时显示 0。",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supportpilot_worker_alive or supportpilot_task_store_up",
          "legendFormat": "{{__name__}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value"
      }
    },
    {
      "id": 12,
      "title": "距离 Worker 最近成功轮询",
      "type": "timeseries",
      "description": "轮询覆盖 Redis 和任务台账；正常模型执行期间会增长，告警阈值 180 秒。",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - supportpilot_worker_last_poll_timestamp_seconds",
          "legendFormat": "{{state}}{{operation}}{{outcome}}{{job}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "title": "?????? ? ???????",
      "type": "timeseries",
      "description": "????/???????????????????????????????????",
      "datasource": {
        "type": "prometheus",
        "uid": "supportpilot-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "supportpilot_task_failures",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
